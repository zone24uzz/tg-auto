# ─────────────────────────────────────────────────────────────
# Telegram AI Auto-Responder — example configuration.
# Copy to .env and fill in. NEVER commit real secrets.
# Most behaviour settings below are only initial defaults: the owner
# changes them later from the admin bot (stored in the database).
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=8080
LOG_LEVEL=info
TIMEZONE=Asia/Tashkent

# PostgreSQL. Local without Docker: `npm run db:local` → the URL below.
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/autoresponder
# docker-compose only (password of the bundled postgres service)
POSTGRES_PASSWORD=

# ── Telegram ─────────────────────────────────────────────────
# Bot from @BotFather with Business Mode enabled (Bot Settings → Business Mode).
TELEGRAM_BOT_TOKEN=
# polling (simple, one instance) | webhook (production behind HTTPS)
TELEGRAM_UPDATE_MODE=polling
# webhook mode: public HTTPS base URL; the app serves /telegram/main (and /telegram/admin)
TELEGRAM_WEBHOOK_URL=
# webhook mode: 16-256 chars [A-Za-z0-9_-]; validated on every webhook request
TELEGRAM_WEBHOOK_SECRET=
# Self-hosted Bot API server (lifts the 20 MB download limit); default is the cloud API
TELEGRAM_API_ROOT=https://api.telegram.org

# How messages of your account reach the system:
#   business = official Telegram Business chatbot (needs Telegram Premium + Business Mode in @BotFather)
#   userbot  = your own account via MTProto (api_id/api_hash from https://my.telegram.org → API development tools).
#              Log in once with /login in the admin bot (QR code). The session is stored encrypted in the DB.
TELEGRAM_TRANSPORT=business
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Optional: a ready GramJS StringSession instead of /login (treat it like a password)
TELEGRAM_SESSION=

# Optional separate admin bot. Empty = the admin panel lives in the private chat with the main bot.
ADMIN_BOT_TOKEN=
# Your numeric Telegram user id (the only person allowed to use the admin panel and the
# only account whose Business connection is accepted). Find it with `npm run whoami`.
ADMIN_TELEGRAM_USER_ID=
OWNER_DISPLAY_NAME=Komron

# ── AI providers (configure at least one) ────────────────────
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# Any OpenAI-compatible endpoint (Ollama, vLLM, OpenRouter, LM Studio …)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODELS=
OPENAI_COMPAT_SUPPORTS_VISION=false
OPENAI_COMPAT_SUPPORTS_REASONING=false
OPENAI_COMPAT_SUPPORTS_TRANSCRIPTION=false

# Initial model selection (changeable in the admin bot)
DEFAULT_AI_PROVIDER=gemini
DEFAULT_AI_MODEL=gemini-3.8-flash
FALLBACK_AI_PROVIDER=gemini
FALLBACK_AI_MODEL=gemini-3.5-flash
MEDIA_AI_PROVIDER=
MEDIA_AI_MODEL=
TRANSCRIPTION_AI_PROVIDER=
TRANSCRIPTION_AI_MODEL=
CLASSIFIER_AI_PROVIDER=
CLASSIFIER_AI_MODEL=
TTS_AI_PROVIDER=
TTS_AI_MODEL=
# minimal | low | medium | high (sent only to models that support it)
DEFAULT_REASONING_EFFORT=low
AI_REQUEST_TIMEOUT_MS=60000
# Optional price overrides, USD per 1M tokens: {"gemini-3.8-flash":{"input":0.3,"output":2.5}}
AI_PRICING_JSON=

# ── Behaviour defaults ───────────────────────────────────────
AUTO_REPLY_ENABLED=true
# text | voice | adaptive (voice needs a TTS-capable provider)
VOICE_RESPONSE_MODE=text

# ── Retention (days) ─────────────────────────────────────────
MESSAGE_RETENTION_DAYS=30
MEDIA_RETENTION_DAYS=3
AI_LOG_RETENTION_DAYS=30
# Keep original media files after processing (default: delete right away)
RETAIN_RAW_MEDIA=false

# ── Limits ───────────────────────────────────────────────────
MAX_MEDIA_SIZE_MB=20
MAX_VIDEO_DURATION=180
MAX_AUDIO_DURATION=600
FRAME_SAMPLE_INTERVAL=5
MAX_FRAMES=6
MAX_DOCUMENT_SIZE_MB=10
MAX_DOCUMENT_CHARS=20000
MAX_MESSAGES_PER_MINUTE=8
MAX_AI_REQUESTS_PER_USER=30
GLOBAL_AI_REQUESTS_PER_MINUTE=60
# USD per day, 0 = unlimited
MAX_DAILY_AI_COST=2

# ── Security / privacy ───────────────────────────────────────
# 32 random bytes, base64 — encrypts message content at rest. REQUIRED in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# Log message text (debugging only; keep false in production)
LOG_MESSAGE_CONTENT=false

# ── Media / storage ──────────────────────────────────────────
MEDIA_TMP_DIR=./data/tmp
# local | s3 (S3, Cloudflare R2, Supabase Storage S3 API, MinIO …)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ── Workers ──────────────────────────────────────────────────
# embedded = jobs run inside the main process; separate = run `npm run start:worker` too
WORKER_MODE=embedded
WORKER_CONCURRENCY_TEXT=4
WORKER_CONCURRENCY_MEDIA=2
